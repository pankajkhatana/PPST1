#include <iostream>
using namespace std;

int main() {
    int rows, i, j, space;

    cout << "Enter number of rows: ";
    cin >> rows;

    for(i = 1; i <= rows; i++) {
        // 1. Print leading spaces
        for(space = 1; space <= rows - i; space++) {
            cout << " ";
        }

        // 2. Print stars
        for(j = 1; j <= (2 * i - 1); j++) {
            cout << "*";
        }

        cout << endl; // New line after each row
    }

    return 0;
}
