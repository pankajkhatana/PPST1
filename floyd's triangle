#include <iostream>
using namespace std;

int main() {
    int rows, i, j, num = 1;

    cout << "Enter number of rows: ";
    cin >> rows;

    for(i = 1; i <= rows; i++) {
        for(j = 1; j <= i; j++) {
            cout << num << " ";
            num++; // Increment the number for every position
        }
        cout << endl; // Move to the next line after each row
    }

    return 0;
}
