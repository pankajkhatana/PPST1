#include <iostream>
using namespace std;

int main() {
    int n, i, j, space;

    cout << "Enter number of rows (top half): ";
    cin >> n;

    // 1. Top Half (Standard Pyramid)
    for(i = 1; i <= n; i++) {
        for(space = 1; space <= n - i; space++) cout << " ";
        for(j = 1; j <= (2 * i - 1); j++) cout << "*";
        cout << endl;
    }

    // 2. Bottom Half (Inverted Pyramid)
    for(i = n - 1; i >= 1; i--) {
        for(space = 1; space <= n - i; space++) cout << " ";
        for(j = 1; j <= (2 * i - 1); j++) cout << "*";
        cout << endl;
    }

    return 0;
}
